anonymous_enable=<%= @anonymous_enable ? 'YES' : 'NO' %>
local_enable=<%= @local_enable ? 'YES' : 'NO' %>
write_enable=<%= @write_enable ? 'YES' : 'NO' %>
local_umask=<%= @local_umask %>
dirmessage_enable=<%= @dirmessage_enable ? 'YES' : 'NO' %>
use_localtime=<%= @use_localtime ? 'YES' : 'NO' %>
xferlog_enable=<%= @xferlog_enable ? 'YES' : 'NO' %>
connect_from_port_20=<%= @connect_from_port_20 ? 'YES' : 'NO' %>
chroot_local_user=<%= @chroot_local_user ? 'YES' : 'NO' %>
secure_chroot_dir=<%= @secure_chroot_dir %>
pam_service_name=<%= @pam_service_name %>
<% if @rsa_cert_file -%>
rsa_cert_file=<%= @rsa_cert_file %>
<% end -%>
<% if @rsa_private_key_file -%>
rsa_private_key_file=<%= @rsa_private_key_file %>
<% end -%>
ssl_enable=<%= @ssl_enable ? 'YES' : 'NO' %>
allow_anon_ssl=NO
force_local_data_ssl=YES
force_local_logins_ssl=YES
ssl_tlsv1=YES
ssl_sslv2=NO
ssl_sslv3=NO
require_ssl_reuse=NO
ssl_ciphers=<%= @ssl_ciphers %>
